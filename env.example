# Copy to .env and fill in for the hosted multi-user "web" mode (python main.py web).
# The local tool (gui / listen / record / analyze / mcp) needs NONE of these.

# --- Google OAuth (from a Google Cloud "OAuth 2.0 Client ID", type: Web application) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control ---
# Comma-separated allowlist of Google emails permitted to sign in (fail-closed: empty = nobody).
FH6_ALLOWLIST=you@example.com,friend@example.com

# --- Sessions ---
# Long random string; keep stable across restarts. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
FH6_SESSION_SECRET=

# --- Public URLs ---
FH6_BASE_URL=https://tuner.example.com          # public URL (use https in prod)
FH6_UDP_PUBLIC_HOST=tuner.example.com           # host users point Data Out at (defaults to BASE_URL host)
# FH6_ROOT_PATH=/forza                          # set only for a sub-path deploy behind a reverse proxy

# --- Telemetry UDP port pool ---
FH6_UDP_PORT_BASE=53000                          # first telemetry port
FH6_UDP_PORT_COUNT=16                            # pool size = max concurrent users
